# Copy this file to .env (which is not committed) and change it if needed.
# The address of the backend API. Only variables starting with VITE_ are
# visible to the frontend code.
VITE_API_URL=http://localhost:8000

# true: use the pretend backend in src/mocks.ts instead of the real one, so
# the app works before every backend endpoint exists. false or missing: use
# the real backend at VITE_API_URL.
VITE_USE_MOCKS=false
